# --- Access -------------------------------------------------------------
# Set a password before exposing this beyond your LAN (HTTP basic auth).
APP_USER=admin
APP_PASSWORD=

# --- Conversion ---------------------------------------------------------
# Calibre output profile: kindle_pw3 (Paperwhite/Oasis/Basic), kindle_scribe,
# kindle_oasis, kindle_voyage, kindle_fire, kindle (old e-ink models)
KINDLE_PROFILE=kindle_pw3
# epub = for Send to Kindle email; azw3 = for USB or the Kindle web browser
OUTPUT_FORMATS=epub,azw3
MAX_DOWNLOAD_MB=200

# --- Send to Kindle by email (optional) ---------------------------------
# Your device address from amazon.com > Manage Your Content and Devices > Preferences
KINDLE_EMAIL=
# SMTP_FROM must be on Amazon's "Approved Personal Document E-mail List".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Email every finished book automatically
AUTO_SEND=false
